# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build outputs
/.next/
/out/

# production
/build

# environment files & secrets
.env*.local
.env
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.crt

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE and OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.agents/
.claude/
.cursor/
.devin/
*.swp
*.swo

# Temporary generated reports
/temp/
*.xlsx
*.xls
