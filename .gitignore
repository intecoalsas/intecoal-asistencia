# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js build outputs
/.next/
/out/

# production
/build

# environment files & secrets
.env*.local
.env
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.crt

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE and OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.agents/
.claude/
.cursor/
.devin/
*.swp
*.swo

# Temporary generated reports
/temp/
*.xlsx
*.xls

# ------------------------------------------------------------------------------
# Archivos locales y sensibles (F1 — protección del repositorio)
# ------------------------------------------------------------------------------

# Certificados y claves locales (HTTPS de desarrollo)
/certs/
*.p12
*.pfx

# Respaldos y volcados de base de datos (pueden contener datos y hashes)
/backups/
*.dump
*.sql.gz
*.bak

# SQL suelto en la raíz (las migraciones en prisma/migrations no se ven afectadas)
/*.sql

# Scripts y archivos temporales locales
/scratch/
/tmp/

# Logs locales
*.log

# Scripts con contraseñas escritas en el código (no versionar)
/src/scripts/create-admin.ts
/src/scripts/create-admin.js
