# ==============================================================================
# INTECOAL ASISTENCIA - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# Copia este archivo a `.env` o `.env.local` y configura los valores correspondientes.
# NUNCA subas archivos con credenciales reales al repositorio.

# ------------------------------------------------------------------------------
# 1. Base de Datos (MySQL)
# ------------------------------------------------------------------------------
# Formato: mysql://[usuario]:[password]@[host]:[puerto]/[database]
DATABASE_URL="mysql://asistencia_app:TU_PASSWORD@localhost:3306/intecoal_asistencia"
# Solo desarrollo: base temporal (shadow) que usa `prisma migrate dev`.
# No es necesaria en producción (allí se usa `prisma migrate deploy`).
SHADOW_DATABASE_URL="mysql://asistencia_app:TU_PASSWORD@localhost:3306/intecoal_asistencia_shadow"

# ------------------------------------------------------------------------------
# 2. Configuración de la Aplicación y Zona Horaria
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="INTECOAL Asistencia"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="America/Bogota"

# ------------------------------------------------------------------------------
# 3. Autenticación y Sesiones
# ------------------------------------------------------------------------------
# Clave aleatoria de 32+ caracteres para firmar sesiones y tokens JWT
NEXTAUTH_SECRET="tu-clave-secreta-de-produccion-minimo-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Seguridad de Kiosco y QR Dinámico
# ------------------------------------------------------------------------------
# Secreto HMAC para la firma y validación de tokens de QR dinámico
QR_HMAC_SECRET="tu-secreto-criptografico-para-qr-dinamico-intecoal"
# Vigencia en segundos del token proyectado en la pantalla del kiosco (ej. 15-30s)
QR_EXPIRATION_SECONDS=25

# ------------------------------------------------------------------------------
# 5. Tareas Programadas / Cron de Infraestructura
# ------------------------------------------------------------------------------
# Token para asegurar los endpoints invocados por tareas programadas (/api/cron/*)
CRON_SECRET="token-de-seguridad-para-invocacion-de-cron-jobs"

# ------------------------------------------------------------------------------
# 6. Servicio de Correo Electrónico (Reportes Automáticos de Asistencia)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notificaciones@ejemplo.com"
SMTP_PASSWORD="tu-password-o-app-password"
EMAIL_FROM="INTECOAL Asistencia <notificaciones@ejemplo.com>"
REPORT_DESTINATARIOS="destinatario1@ejemplo.com,destinatario2@ejemplo.com"

# ------------------------------------------------------------------------------
# 7. Preparación para Despliegue en AWS (Opcional para fases posteriores)
# ------------------------------------------------------------------------------
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_REPORTES=""

